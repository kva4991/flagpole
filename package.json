{
  "name": "super-pommels-and-flag",
  "private": true,
  "type": "module",
  "version": "0.7.6",
  "scripts": {
    "identity:generate": "node scripts/generateProjectIdentity.mjs",
    "identity:check": "node scripts/generateProjectIdentity.mjs --check",
    "catalog:callouts": "node scripts/runPython.mjs mechanical/render_catalog_part_callouts_v075.py",
    "catalog:callouts:check": "node scripts/runPython.mjs mechanical/render_catalog_part_callouts_v075.py --check",
    "catalog:generate": "npm run catalog:callouts && node scripts/generateComponentCatalog.mjs",
    "catalog:check": "npm run catalog:callouts:check && node scripts/generateComponentCatalog.mjs --check",
    "models:semantics:check": "node scripts/runPython.mjs mechanical/validate_catalog_model_semantics_v075.py",
    "review:impact": "node scripts/inspectChangeImpact.mjs --git origin/main",
    "quality:docs": "node scripts/checkDocumentation.mjs",
    "quality:docs:all": "node scripts/checkDocumentation.mjs",
    "checksums:update": "node scripts/checkChecksums.mjs --update",
    "checksums:check": "node scripts/checkChecksums.mjs --check",
    "toolchain:check": "powershell -ExecutionPolicy Bypass -File tools/windows/check.ps1",
    "test": "node --test tests/*.test.mjs",
    "quality:gate": "npm run identity:check && npm run quality:docs:all && npm run catalog:callouts:self-test && npm run models:layout:self-test && npm run catalog:check && npm run models:semantics:check && npm test && npm run checksums:check",
    "catalog:callouts:self-test": "node scripts/runPython.mjs mechanical/render_catalog_part_callouts_v075.py --self-test",
    "models:layout:self-test": "node scripts/runPython.mjs mechanical/layout_packing.py --self-test"
  }
}
